# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Vercel KV — set automatically by Vercel when you link a KV database
# For local dev, create a KV store at https://vercel.com/storage/kv and run:
#   vercel env pull .env.local
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...
